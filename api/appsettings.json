{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Auth": { "MaxUsers": 2 },
  "Identity": {
    "Authority": "https://fitness-account.example.invalid",
    "Issuer": "https://fitness-account.example.invalid",
    "ClientId": "workout-api",
    "ClientSecret": "replace-in-secret-manager",
    "RedirectUri": "https://workout-api.example.invalid/api/auth/central/callback",
    "ReturnUrl": "/",
    "ConnectReturnUrl": "/settings",
    "WorkoutAudience": "workout-api",
    "NutritionAudience": "nutrition-api"
  },
  "Integrations": {
    "EncryptionKey": "development-only-integration-key",
    "KmsKeyName": "",
    "NutritionTrainingContextUrl": ""
  },
  "Database": { "MigrateOnStartup": false },
  "Retention": {
    "ImportDays": 30,
    "ReceiptDays": 90,
    "AiUsageMonths": 2
  },
  "ImportWorker": { "Enabled": false, "PollingEnabled": false },
  "OpenAi": { "Model": "gpt-5.4-mini", "DailyRequestsPerUser": 20 }
}
