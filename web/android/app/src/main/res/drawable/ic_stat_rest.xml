<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for the workout and rest notifications: the app icon's W mark, drawn white on a
     transparent field as Android expects. The group scales the 512-unit favicon artwork to fit. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:scaleX="0.0529"
        android:scaleY="0.0529"
        android:translateX="-3.24"
        android:translateY="-1.54">
        <path
            android:pathData="M120,168l55,176l81,-128l81,128l55,-176"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="42"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
